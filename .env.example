# Optional overrides when launching from a shell:
# DB_PATH=/absolute/path/to/custom.sqlite
# LOG_LEVEL=debug
#
# If the embedded casino strip stays blank (DNS / ERR_NAME_NOT_RESOLVED / -105), fix network
# or try a separate Chromium window:
# RSA_EMBEDDED_TABLE=0
#
# If human-verification (CAPTCHA) loops in the embedded table, try the same — Electron differs
# from Safari/Chrome and some sites still block; RSA_EMBEDDED_TABLE=0 uses Playwright Chromium.
#
# If port 17789 clashes with another app:
# RSA_CDP_PORT=17790
