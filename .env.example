# Optional overrides when launching from a shell:
# DB_PATH=/absolute/path/to/custom.sqlite
# LOG_LEVEL=debug
#
# Table display: in the app UI, Settings → «Embed casino table» (default off = separate Chrome window).
# Env always wins: RSA_EMBEDDED_TABLE=0 forces the separate window even if embed is on.
#
# If the embedded casino strip stays blank (DNS / ERR_NAME_NOT_RESOLVED / -105), fix network
# or use RSA_EMBEDDED_TABLE=0 / turn off embed in Settings.
#
# If human-verification (CAPTCHA) loops, prefer Settings off (Chrome window) or RSA_EMBEDDED_TABLE=0.
# When embed is on, delay before Playwright CDP attach (ms). Default 4500. Set 0 to skip wait.
# RSA_EMBEDDED_CDP_DELAY_MS=8000
#
# Electron embed CDP port (default 17789):
# RSA_ELECTRON_CDP_PORT=17789
# External Chrome CDP for parser (default 9222):
# RSA_EXTERNAL_CDP_PORT=9222
# Table window: cdp-chrome | webkit | embedded (or Settings → table browser)
# RSA_TABLE_BROWSER=cdp-chrome
#
# Linux-in-Docker only: if Playwright Chrome fails to start with sandbox on, try:
# RSA_PLAYWRIGHT_NO_SANDBOX=1
