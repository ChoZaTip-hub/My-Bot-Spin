# Optional overrides when launching from a shell:
# DB_PATH=/absolute/path/to/custom.sqlite
# LOG_LEVEL=debug
#
# If the embedded casino strip stays blank and the console shows DNS errors
# (e.g. ERR_NAME_NOT_RESOLVED / -105), fix network/DNS or try a separate Chromium:
# RSA_EMBEDDED_TABLE=0
#
# If port 17789 clashes with another app:
# RSA_CDP_PORT=17790
